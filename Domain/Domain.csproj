    <Compile Include="Enums\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Interfaces\Repositories\IUserRepository.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Events\" />
    <Folder Include="Specifications\" />
  </ItemGroup>

</Project>
